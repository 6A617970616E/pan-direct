{
  "name": "pan-direct",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PanDirect lightweight MV3 netdisk direct-download extension (Store & Community dual-artifact builds)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:store": "node scripts/build.mjs --target=store",
    "build:community": "node scripts/build.mjs --target=community",
    "sync-root": "node scripts/build.mjs --sync-root --no-dist",
    "version:check": "node scripts/bump-version.mjs --check",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.browser.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
